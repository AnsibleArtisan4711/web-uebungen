{
  "name": "portfolio-modul-21",
  "private": true,
  "description": "Portfolio nach Modul 21 (Kosten, Migration, Governance, Backup und Notfallplanung). Die Seite selbst braucht keine Abhängigkeiten; Werkzeuge stehen in devDependencies.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "test": "node --test",
    "css": "node tools/css-bauen.js",
    "css:pruefen": "node tools/css-bauen.js --pruefen",
    "lint:css": "stylelint \"css/src/**/*.css\"",
    "lint:js": "eslint js tools tests e2e playwright.config.js",
    "format:pruefen": "prettier --check \"css/src/**/*.css\" \"js/**/*.js\" \"e2e/**/*.js\" playwright.config.js",
    "lint": "npm run lint:css && npm run lint:js",
    "css:browser": "stylelint --config .stylelintrc.browser.json \"css/src/**/*.css\"",
    "validate:html": "html-validate 404.html wartung.html index.html blog kontakt lebenslauf projekte styleguide impressum datenschutz",
    "validate:w3c": "node tools/validate-w3c.js",
    "namen": "node tools/naming-check.js",
    "doku": "node tools/doku-check.js",
    "build": "node tools/dist-bauen.js",
    "budget": "node tools/budget-check.js",
    "security": "node tools/security-check.js",
    "links": "node tools/linkcheck.js",
    "serve": "node tools/server.js 8080",
    "serve:dist": "node tools/server.js 8080 dist",
    "e2e": "playwright test",
    "e2e:baseline": "playwright test e2e/visuell.spec.js --update-snapshots",
    "kosten": "node tools/kosten.js",
    "legacy": "node tools/legacy-check.js",
    "redirects": "node tools/redirect-check.js docs/relaunch/url-mapping.csv --alt docs/relaunch/alte-urls.txt",
    "drittanbieter": "node tools/drittanbieter-check.js index.html blog kontakt lebenslauf projekte styleguide impressum datenschutz 404.html wartung.html css",
    "backup": "node tools/backup.js dist backups",
    "restore:pruefen": "node tools/restore-pruefen.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "html-validate": "^11.19.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "vnu-jar": "^26.11.4"
  }
}
