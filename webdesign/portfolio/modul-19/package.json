{
  "name": "portfolio-modul-19",
  "private": true,
  "description": "Portfolio nach Modul 19 (Tooling, Deployment, Wartung). Die Seite selbst braucht keine Abhängigkeiten; Werkzeuge stehen in devDependencies.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "test": "node --test",
    "css": "node tools/css-bauen.js",
    "css:pruefen": "node tools/css-bauen.js --pruefen",
    "lint:css": "stylelint \"css/src/**/*.css\"",
    "lint:js": "eslint js tools tests",
    "format:pruefen": "prettier --check \"css/src/**/*.css\" \"js/**/*.js\"",
    "lint": "npm run lint:css && npm run lint:js",
    "build": "node tools/dist-bauen.js",
    "budget": "node tools/budget-check.js",
    "security": "node tools/security-check.js",
    "links": "node tools/linkcheck.js",
    "serve": "node tools/server.js 8080",
    "serve:dist": "node tools/server.js 8080 dist"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
